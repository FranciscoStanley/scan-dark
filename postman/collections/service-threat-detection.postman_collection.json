{
  "info": {
    "name": "ScanDark — service-threat-detection",
    "description": "Detecção de intrusões: câmeras WiFi, RDP, SSH, dispositivos não autorizados — porta 3005\n\nSwagger: http://localhost:3005/docs\n\nAutor: Francisco Stanley Rodrigues Albuquerque",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3005" },
    { "key": "accessToken", "value": "" },
    { "key": "threatId", "value": "" }
  ],
  "item": [
    {
      "name": "Analyze — External Camera Access",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "if (Array.isArray(res) && res[0]?.id) pm.collectionVariables.set('threatId', res[0].id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceIp\": \"203.0.113.45\",\n  \"targetIp\": \"192.168.1.100\",\n  \"targetPort\": 554,\n  \"deviceType\": \"camera\",\n  \"protocol\": \"rtsp\",\n  \"eventType\": \"unauthorized_stream_access\"\n}"
        },
        "url": "{{baseUrl}}/threats/analyze",
        "description": "Detecta acesso externo não autorizado a câmera WiFi via RTSP"
      }
    },
    {
      "name": "Analyze — SSH Brute Force",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceIp\": \"192.168.1.200\",\n  \"targetIp\": \"192.168.1.1\",\n  \"targetPort\": 22,\n  \"protocol\": \"ssh\",\n  \"eventType\": \"ssh_brute_force\"\n}"
        },
        "url": "{{baseUrl}}/threats/analyze"
      }
    },
    {
      "name": "Analyze — RDP External",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceIp\": \"198.51.100.22\",\n  \"targetIp\": \"192.168.1.50\",\n  \"targetPort\": 3389,\n  \"deviceType\": \"computer\",\n  \"protocol\": \"rdp\",\n  \"eventType\": \"brute_force\"\n}"
        },
        "url": "{{baseUrl}}/threats/analyze"
      }
    },
    {
      "name": "Monitor Network",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"network\": \"192.168.1.0\",\n  \"cidr\": 24\n}"
        },
        "url": "{{baseUrl}}/threats/monitor",
        "description": "Monitoramento contínuo — simula e detecta ameaças na rede"
      }
    },
    {
      "name": "List All Threats",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/threats"
      }
    },
    {
      "name": "List Active Threats",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/threats/active"
      }
    },
    {
      "name": "Threat Stats",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/threats/stats"
      }
    },
    {
      "name": "Resolve Threat",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/threats/{{threatId}}/resolve"
      }
    }
  ]
}
