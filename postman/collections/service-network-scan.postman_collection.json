{
  "info": {
    "name": "ScanDark — service-network-scan",
    "description": "Varredura de rede, port scan, auditoria WiFi/roteador — porta 3002\n\nSwagger: http://localhost:3002/docs\n\nAutor: Francisco Stanley Rodrigues Albuquerque",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3002" },
    { "key": "accessToken", "value": "" },
    { "key": "scanId", "value": "" },
    { "key": "userId", "value": "00000000-0000-0000-0000-000000000001" }
  ],
  "item": [
    {
      "name": "Create Scan",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const res = pm.response.json();",
              "if (res.id) pm.collectionVariables.set('scanId', res.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "x-user-id", "value": "{{userId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Scan Rede Doméstica\",\n  \"type\": \"full_assessment\",\n  \"targetNetwork\": \"192.168.1.0\",\n  \"cidr\": 24,\n  \"ports\": [22, 80, 443, 554, 3389]\n}"
        },
        "url": "{{baseUrl}}/scans",
        "description": "Tipos: network_discovery, port_scan, iot_fingerprint, wifi_audit, router_audit, threat_monitor, full_assessment"
      }
    },
    {
      "name": "List Scans",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "x-user-id", "value": "{{userId}}" }
        ],
        "url": "{{baseUrl}}/scans"
      }
    },
    {
      "name": "Get Scan by ID",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "x-user-id", "value": "{{userId}}" }
        ],
        "url": "{{baseUrl}}/scans/{{scanId}}"
      }
    }
  ]
}
